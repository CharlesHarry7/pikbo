# --- Video generation (ByteDance Seedance via fal.ai) ---
# Get free signup credits: https://fal.ai/dashboard/keys
# Without FAL_KEY → DEMO mode (local /demos/* toy clips).
FAL_KEY=

# Wool / free trial path (cheapest): Mini @ ~$0.07/s 480p
# FAL_MODEL_FREE=bytedance/seedance-2.0/mini/image-to-video
# Paid default:
# FAL_MODEL=bytedance/seedance-2.0/image-to-video
# Optional paid-fast:
# FAL_MODEL_FAST=bytedance/seedance-2.0/fast/image-to-video

# --- Session / credits (signed cookie) ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Supabase Auth + durable credits (T5) ---
# Project Settings → API. Publishable = anon; Secret service_role = server only.
# SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Optional Google OAuth (after enabling in Supabase Providers):
# SUPABASE_AUTH_GOOGLE=1

# --- Site URL (magic-link redirect origin) ---
# Local default is http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://your-preview.vercel.app

# --- Stripe billing (private test preview only until every launch gate passes) ---
# STRIPE_SECRET_KEY=sk_test_...
# One recurring monthly Price for the only paid plan: Founding Studio.
# STRIPE_PRICE_FOUNDING_STUDIO=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL: https://YOUR_DOMAIN/api/webhooks/stripe
# Set only after 20260729030000_stripe_billing_idempotency.sql passes a
# disposable/non-production DB rehearsal. Checkout/webhook fail closed without it.
# STRIPE_BILLING_RPC_READY=0
# Soft launch: leave payments off
# NEXT_PUBLIC_PAYMENTS_ENABLED=0
# Never set PAYMENTS_LIVE=1 until the quality, privacy, accounting, and Beta
# gates in the launch plan have passed.
# PAYMENTS_LIVE=0
# Refund/dispute credit revocation is not implemented yet. Keep this at 0.
# Live Checkout requires both this rehearsed guard and PAYMENTS_LIVE=1.
# STRIPE_REFUND_DISPUTE_GUARD_READY=0

# --- Async video provider webhooks (fal / future) ---
# Production refuses UNSIGNED POSTs to /api/webhooks/video-provider.
# Generate a long random secret and share it only with the provider callback config.
# VIDEO_PROVIDER_WEBHOOK_SECRET=
# Webhook URL: https://YOUR_DOMAIN/api/webhooks/video-provider
# Optional: auto-expire in-flight generate locks (ms, default ~200000)
# PIKBO_INFLIGHT_TTL_MS=200000

# Explicit local billing fixture only. Forbidden/ignored in production.
# STRIPE_BILLING_FIXTURE_MODE=0
# ENTITLEMENTS_PATH=/tmp/pikbo-entitlements-fixture.json

# Force durable path (requires writable store / Supabase schema).
# Set both readiness flags to 1 only after the matching non-production
# migration, rollback, crash-window, and race rehearsals pass.
# REQUIRE_DURABLE_CREDITS=0
# PIKBO_DURABLE_BACKEND=local
# PIKBO_R1_ATOMIC_RESERVATION_READY=0
# PIKBO_R1_RECONCILIATION_READY=0

# Local dev upgrade requires BOTH ALLOW_DEV_UPGRADE=1 and
# STRIPE_BILLING_FIXTURE_MODE=1 plus body.dev=true. It is hard-off in production.
# ALLOW_DEV_UPGRADE=0

# Local free-credit refill: POST /api/dev/topup (also on when NODE_ENV=development)
# PIKBO_DEV_TOPUP=1

# G6 refund automation only (never production):
# PIKBO_FORCE_GENERATE_FAIL=1

# Optional analytics (no-op if empty — never blocks build)
# JSON beacon endpoint (legacy / custom)
# NEXT_PUBLIC_ANALYTICS_URL=
# Google Analytics 4 measurement id only (G-XXXXXXXX). No secrets.
# Only six canonical events may leave the browser: create_view,
# asset_upload_complete, generation_start, generation_success, download,
# regenerate_7d. Never sends photos, prompts, emails, object keys, or asset URLs.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# T6 server-owned file watermark bake (disabled until non-prod rehearsal)
# All paths must be absolute. The owned directory must be private/persistent.
# PIKBO_FFMPEG_PATH=/usr/local/bin/ffmpeg
# PIKBO_FFPROBE_PATH=/usr/local/bin/ffprobe
# PIKBO_T6_OWNED_STORAGE_DIR=/var/lib/pikbo/private-media
# Comma-separated exact/suffix CDN host allowlist; redirects are rejected.
# PIKBO_T6_PROVIDER_HOST_ALLOWLIST=fal.media,storage.googleapis.com
# Operator request only; code/health remains blocked until the persisted worker
# and docs/ops/T6_NON_PROD_REHEARSAL.md proof are complete.
# PIKBO_T6_BAKED_WATERMARK_WORKER=0

# --- Issue #54 private-beta live (invited owner only; no public uncapped spend) ---
# Requires auth + durable atomic reserve + FAL_KEY. Never enables anonymous live.
# PIKBO_PRIVATE_LIVE_ENABLED=0
# Comma-separated lowercased emails and/or Supabase user ids (not secrets).
# PIKBO_PRIVATE_LIVE_ALLOWLIST=owner@example.com
# Per-process admission fuse. Durable wallet/reservation is the spend authority;
# this counter is not a cross-instance production budget.
# PIKBO_PRIVATE_LIVE_BUDGET_MAX=3
# Durable non-production provider budget. Both values are required; production
# is hard-closed even if copied there. The SQL ceiling is permanently <= US$20.
# PIKBO_PROVIDER_VALIDATION_MODE=0
# PIKBO_PROVIDER_VALIDATION_BUDGET_USD=20
# Vercel Preview uses NODE_ENV=production. This third opt-in allows the protected
# branch Preview only; VERCEL_ENV=production remains hard-closed.
# PIKBO_PREVIEW_PROVIDER_VALIDATION_ENABLED=0
# Long random secret for the server-side queued-job expiry/reconciliation worker.
# PIKBO_INTERNAL_WORKER_SECRET=
# Required for copying trusted provider output into private Pikbo storage.
# Exact hosts or parent suffixes; redirects are rejected.
# PIKBO_PROVIDER_OUTPUT_HOST_ALLOWLIST=fal.media,storage.googleapis.com

# See docs/growth/STRIPE_TEST_SETUP.md before enabling the private test Preview.
